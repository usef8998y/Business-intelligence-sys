generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  RETURNED
}

enum ImportStatus {
  PENDING
  VALIDATED
  FAILED
  IMPORTED
}

enum DatasetType {
  BRANCHES
  PRODUCTS
  SALES
  SALE_ITEMS
  PRODUCT_COSTS
  INVENTORY_SNAPSHOTS
}

model Branch {
  id        String               @id @map("branch_id")
  name      String
  city      String
  sales     Sale[]
  inventory InventorySnapshot[]

  @@map("branches")
}

model Product {
  id        String               @id @map("product_id")
  name      String
  category  String
  active    Boolean              @default(true)
  saleItems SaleItem[]
  costs     ProductCost[]
  inventory InventorySnapshot[]

  @@map("products")
}

model Sale {
  id       String     @id @map("sale_id")
  branchId String     @map("branch_id")
  soldAt   DateTime   @map("sold_at")
  status   SaleStatus
  branch   Branch     @relation(fields: [branchId], references: [id])
  items    SaleItem[]

  @@index([branchId, soldAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @map("sale_item_id")
  saleId    String  @map("sale_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("sale_items")
}

model ProductCost {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  effectiveFrom DateTime @map("effective_from")
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 2)
  product       Product  @relation(fields: [productId], references: [id])

  @@unique([productId, effectiveFrom])
  @@map("product_costs")
}

model InventorySnapshot {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  productId      String   @map("product_id")
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  quantityOnHand Decimal  @map("quantity_on_hand") @db.Decimal(12, 3)
  branch         Branch   @relation(fields: [branchId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])

  @@unique([branchId, productId, snapshotDate])
  @@map("inventory_snapshots")
}

model DatasetImport {
  id          String           @id @default(uuid()) @map("import_id")
  datasetType DatasetType      @map("dataset_type")
  importedAt  DateTime         @default(now()) @map("imported_at")
  status      ImportStatus     @default(PENDING)
  rowErrors   ImportRowError[]

  @@map("dataset_imports")
}

model ImportRowError {
  id        String        @id @default(uuid())
  importId  String        @map("import_id")
  rowNumber Int           @map("row_number")
  errorCode String        @map("error_code")
  import    DatasetImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@map("import_row_errors")
}
