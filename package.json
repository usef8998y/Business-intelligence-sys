{
  "name": "retail-bi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Retail Business Intelligence MVP backend (Node.js + TypeScript + Express + PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/importExcel.ts",
    "migrate:statuses": "tsx src/scripts/normalizeStatuses.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
